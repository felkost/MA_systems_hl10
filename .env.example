# Only keys with no code default live here. A default duplicated between
# this file and config.py drifts, and the .env copy silently wins (measured
# in hl8) -- so every tunable with a sensible default lives in config.py only.
# The two lines below are the one deliberate exception: LLM_PROVIDER and
# EMBEDDING_PROVIDER both default to "openai" in config.py, so they stay
# commented out here -- shown for discoverability (the toggle exists, these
# are its only two values), never read as long as the "#" stays, and
# therefore unable to drift from the default it documents.

# LLM_PROVIDER=openai
# openai | openrouter. Per-role overrides (PLANNER_PROVIDER, CRITIC_MODEL_NAME,
# etc.) exist too -- see README.md, "Configuration: providers and models".
OPENAI_API_KEY=
OPENROUTER_API_KEY=

# EMBEDDING_PROVIDER=openai
# openai | local. OpenRouter has no embeddings endpoint, which is why this is
# a separate toggle from LLM_PROVIDER. "local" needs no key but EMBEDDING_MODEL
# must then name a real Hugging Face id, not an OpenAI one.

# Shared bearer token verified by SearchMCP, ReportMCP and all three A2A
# agent servers. Any long random string; every process reads the same value.
MCP_A2A_SHARED_TOKEN=

# Langfuse SDK keys -- created in the Langfuse UI after the first
# `docker compose up -d` (stage 9). Tracing without keys is refused, not
# attempted.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# Secrets for the self-hosted Langfuse stack (docker-compose.yml).
# Generate long random strings; none of these have defaults on purpose.
POSTGRES_PASSWORD=
CLICKHOUSE_PASSWORD=
REDIS_AUTH=
MINIO_ROOT_PASSWORD=
LANGFUSE_SALT=
LANGFUSE_ENCRYPTION_KEY=
NEXTAUTH_SECRET=
